<Window x:Class="Kurs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АЛТЫН - Вход" Height="450" Width="400" WindowStartupLocation="CenterScreen"
        Icon="ico.ico" >
    <Border Background="#F5F5F5" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="АЛТЫН" FontSize="42" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center"/>
            <TextBlock Text="ЛОМБАРДНАЯ СЕТЬ" FontSize="12" Margin="0,0,0,30" HorizontalAlignment="Center" Opacity="0.6"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin" Margin="0,5,0,15" Padding="5" MaxLength="20"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword" Margin="0,5,0,20" Padding="5" MaxLength="20"/>

            <TextBlock x:Name="txtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Content="ВОЙТИ" Height="40" Background="#D4AF37" Foreground="White" FontWeight="Bold" Click="Login_Click"/>
        </StackPanel>
    </Border>
</Window>