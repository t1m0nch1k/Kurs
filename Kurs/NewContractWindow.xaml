<Window x:Class="Kurs.NewContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kurs"
        Title="Новый договор" Height="750" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="ico.ico">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        
        <!-- Конвертер для отображения байтового массива как изображения -->
        <local:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>

    <Border Padding="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== ЛЕВАЯ ПАНЕЛЬ ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <!-- Клиент -->
                <TextBlock Text="Клиент" Style="{StaticResource Label}"/>
                <ComboBox x:Name="comboClients"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="ClientID"/>

                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,14,0,14"/>

                <!-- Описание изделия -->
                <TextBlock Text="Описание изделия" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtDescription" Margin="0,0,0,0"/>

                <!-- Фотография изделия -->
                <TextBlock Text="Фотография изделия" Style="{StaticResource Label}"/>
                <Border x:Name="borderItemPhoto" BorderBrush="#CCCCCC" BorderThickness="1" 
                        Height="150" Margin="0,0,0,5" Background="#F5F5F5">
                    <Grid>
                        <Image x:Name="imgItemPhoto" Stretch="Uniform"/>
                        <TextBlock x:Name="txtPhotoPlaceholder" Text="Нет фото" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="#999999" FontSize="14"/>
                    </Grid>
                </Border>
                <Button Content="📷 Загрузить фото" Height="30" Margin="0,0,0,8"
                        Background="#3498DB" Foreground="White"
                        Click="btnLoadPhoto_Click"/>
                <Button Content="🗑 Удалить фото" Height="30" Margin="0,0,0,8"
                        Background="#E74C3C" Foreground="White"
                        Click="btnRemovePhoto_Click"/>

                <!-- Тип изделия -->
                <TextBlock Text="Тип изделия" Style="{StaticResource Label}"/>
                <ComboBox x:Name="comboItemTypes"
                          DisplayMemberPath="TypeName"
                          SelectedValuePath="TypeID"/>

                <!-- Металл и проба -->
                <TextBlock Text="Металл и проба" Style="{StaticResource Label}"/>
                <ComboBox x:Name="comboMetals" SelectionChanged="comboMetals_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MetalsCatalog.MetalName}" FontWeight="Bold"/>
                                <TextBlock Text=" — "/>
                                <TextBlock Text="{Binding MetalsCatalog.PurityValue}"/>
                                <TextBlock Text=" проба  ("/>
                                <TextBlock Text="{Binding PricePerGram, StringFormat={}{0:F2}}"/>
                                <TextBlock Text=" ₽/г)"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Цена за грамм (авто) -->
                <TextBlock Text="Цена за грамм (₽)" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtPricePerGram" IsReadOnly="True"
                         Background="#F0F0F0" Foreground="#555"/>

                <!-- Вес -->
                <TextBlock Text="Вес (гр)" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtWeight" TextChanged="RecalcItem"/>

                <!-- Оценочная стоимость (авто) -->
                <TextBlock Text="Оценочная стоимость (₽)" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtEstimate" IsReadOnly="True"
                         Background="#F0F0F0" Foreground="#555"/>

                <Button Content="➕ Добавить изделие в список"
                        Height="36" Margin="0,14,0,0"
                        Background="#2980B9" Foreground="White"
                        FontWeight="Bold"
                        Click="btnAddToTemp_Click"/>
            </StackPanel>

            <!-- ===== ПРАВАЯ ПАНЕЛЬ ===== -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Таблица добавленных изделий -->
                <DataGrid x:Name="gridAddedItems"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserResizeColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Фото" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="50" Height="50" Stretch="UniformToFill">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ByteArrayToImageConverter}">
                                                <Binding Path="ItemPhoto"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Вес (г)"
                                            Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="60"/>
                        <DataGridTextColumn Header="Оценка (₽)"
                                            Binding="{Binding EstimatedValue, StringFormat={}{0:F2}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Итоговый блок -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">

                    <!-- Удалить выделенное изделие -->
                    <Button Content="🗑 Удалить выбранное изделие"
                            Height="30" Margin="0,0,0,10"
                            Background="#C0392B" Foreground="White"
                            Click="btnRemoveItem_Click"/>

                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <!-- Параметры договора -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Дата выдачи" Style="{StaticResource Label}"/>
                        <DatePicker x:Name="dpIssueDate"
                                    Grid.Row="1" Grid.Column="0"
                                    Margin="0,0,6,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="Дата погашения" Style="{StaticResource Label}"/>
                        <DatePicker x:Name="dpDueDate"
                                    Grid.Row="1" Grid.Column="1"
                                    Margin="6,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Ставка (%/мес)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="txtInterestRate"
                                 Grid.Row="3" Grid.Column="0"
                                 Margin="0,0,6,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="Сумма займа (₽) — авто" Style="{StaticResource Label}"/>
                        <TextBox x:Name="txtLoanAmount"
                                 Grid.Row="3" Grid.Column="1"
                                 IsReadOnly="True" Background="#F0F0F0"
                                 Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Кнопка оформить -->
                    <Button Content="✅  ОФОРМИТЬ ДОГОВОР"
                            Height="46" Margin="0,14,0,0"
                            Background="#D4AF37" Foreground="White"
                            FontSize="15" FontWeight="Bold"
                            Click="btnFinalSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
