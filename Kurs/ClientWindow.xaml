<Window x:Class="Kurs.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Height="550" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="ico.ico">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4"/>
        </Style>
    </Window.Resources>

    <Border Padding="22">
        <StackPanel>

            <!-- Заголовок -->
            <TextBlock x:Name="txtTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

            <!-- Фамилия -->
            <TextBlock Text="Фамилия *" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="txtLastName"/>

            <!-- Имя / Отчество в одну строку -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Имя *" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="txtFirstName"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Отчество" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="txtMiddleName"/>
                </StackPanel>
            </Grid>

            <!-- Дата рождения / Телефон в одну строку -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата рождения *" Style="{StaticResource Lbl}"/>
                    <DatePicker x:Name="dpBirthDate"
                                SelectedDateChanged="dpBirthDate_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Возраст" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="txtAge" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#555"/>
                </StackPanel>
            </Grid>

            <!-- Телефон -->
            <TextBlock Text="Телефон *" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="txtPhone"/>

            <!-- Паспорт -->
            <TextBlock Text="Паспортные данные *" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="txtPassport"/>

            <!-- Ошибки -->
            <Border x:Name="pnlError" Visibility="Collapsed"
                    Background="#FFEBEE" BorderBrush="#E57373"
                    BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,12,0,0">
                <TextBlock x:Name="txtError" Foreground="#C62828"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Сохранить" Width="110" Click="btnSave_Click"
                        Background="#27AE60" Foreground="White"
                        Padding="0,6" Margin="0,0,10,0" FontWeight="Bold"/>
                <Button Content="Отмена" Width="90" IsCancel="True" Padding="0,6"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
