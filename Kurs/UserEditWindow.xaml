<Window x:Class="Kurs.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="ico.ico">
    <StackPanel Margin="24">

        <TextBlock Text="ФИО:" Margin="0,0,0,2"/>
        <TextBox x:Name="txtFullName" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Text="Логин:" Margin="0,0,0,2"/>
        <TextBox x:Name="txtLogin" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Text="Пароль (оставьте пустым, чтобы не менять):" Margin="0,0,0,2"/>
        <PasswordBox x:Name="pbPassword" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Text="Роль:" Margin="0,0,0,2"/>
        <ComboBox x:Name="cbRole"
                  DisplayMemberPath="RoleName"
                  SelectedValuePath="RoleID"
                  Padding="5" Margin="0,0,0,14"/>

        <StackPanel x:Name="pnlError" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock x:Name="txtError" Foreground="Red" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="btnSave_Click"
                    Background="#27AE60" Foreground="White"
                    Padding="15,5" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="15,5"/>
        </StackPanel>

    </StackPanel>
</Window>
