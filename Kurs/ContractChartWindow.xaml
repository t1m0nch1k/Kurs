<Window x:Class="Kurs.ContractChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Диаграмма контрактов" Height="550" Width="700" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="ico.ico">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📊 Статистика контрактов" FontSize="24" FontWeight="Bold" 
                   Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <!-- Диаграмма по статусам -->
            <GroupBox Header="Распределение по статусам" Margin="0,0,0,15" Padding="15">
                <lvc:CartesianChart x:Name="chartStatus" Height="250" LegendLocation="Bottom">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Статус" Labels="{Binding StatusLabels}"/>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Количество" MinValue="0"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </GroupBox>

            <!-- Сводная информация -->
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Border Background="#3498DB" CornerRadius="8" Margin="5" Padding="15">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Активные" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtActiveCount" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#E74C3C" CornerRadius="8" Margin="5" Padding="15">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Просроченные" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtOverdueCount" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#27AE60" CornerRadius="8" Margin="5" Padding="15">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Закрытые" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtClosedCount" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Дополнительная статистика -->
            <Border Background="#F8F9FA" BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="8" Margin="0,15,0,0" Padding="15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Всего контрактов: " FontWeight="Bold" Width="140"/>
                        <TextBlock x:Name="txtTotalContracts" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Общая сумма займов: " FontWeight="Bold" Width="140"/>
                        <TextBlock x:Name="txtTotalAmount" FontWeight="Bold" Foreground="#D4AF37"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Сумма активных: " FontWeight="Bold" Width="140"/>
                        <TextBlock x:Name="txtActiveAmount" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Сумма просроченных: " FontWeight="Bold" Width="140"/>
                        <TextBlock x:Name="txtOverdueAmount" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Button Grid.Row="2" Content="Закрыть" Click="btnClose_Click" 
                Background="#2C3E50" Foreground="White" 
                Padding="30,10" Margin="0,20,0,0" FontSize="14" Width="150"/>
    </Grid>
</Window>
