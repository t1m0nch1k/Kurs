<Window x:Class="Kurs.EditRate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать цену" Height="220" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="ico.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtMetal" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Text="Цена за грамм (₽):"/>
        <TextBox x:Name="txtPrice" Margin="0,4,0,12" Padding="5"/>

        <StackPanel x:Name="pnlError" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock x:Name="txtError" Foreground="Red" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="btnSave_Click"
                    Background="#27AE60" Foreground="White"
                    Padding="15,5" Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="15,5"/>
        </StackPanel>
    </StackPanel>
</Window>
